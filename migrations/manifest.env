APPLY_COMMAND="for f in migrations/*.sql; do psql -v ON_ERROR_STOP=1 -f \"$f\"; done"

ACCOUNTS_TABLE="account"
ACCOUNTS_STATE_COLUMN="state"

ACCOUNT_STATE_VALUE_1="ACTIVE"
ACCOUNT_STATE_VALUE_2="SUSPENDED"
ACCOUNT_STATE_VALUE_3="CLOSED"

ORDERS_TABLE="order_history"
ORDERS_IDEMPOTENCY_KEY_COLUMN="idempotency_key"